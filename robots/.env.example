# The robot swarm reads this file, and so does `agentd`. Everything here is
# optional: with none of it set the whole system still runs — BM25 is SQLite's
# own, semantic search falls back to a local embedder, and a turn answers out
# of the archive and says the link is down.

# ---------------------------------------------------------- on-device AI --
#
# The on-device brain is the MLX engine when the backend was built with it
# (`make gui`), and otherwise a local ollama daemon holding the same model:
#
#     brew install ollama            # or `make install`
#     ollama serve                   # the daemon, on localhost:11434
#     ollama pull qwen3.8:27b-mlx    # or `make ollama-model`
#
# `make robots` — the lean build with no Xcode — gets a real on-device brain
# this way. Nothing leaves the machine either way.

# auto | mlx | ollama | off. `auto` is MLX when this build carries it and the
# weights are on disk, the daemon otherwise.
ONDEVICE_ENGINE=auto

# Where the daemon listens, and the tag it answers with.
ONDEVICE_HOST=http://localhost:11434
ONDEVICE_MODEL=qwen3.8:27b-mlx

# The daemon's embedding model, for real vectors in semantic search
# (`ollama pull embeddinggemma`). Without it the local hashing embedder
# takes over and says so.
ONDEVICE_EMBED=embeddinggemma

# --------------------------------------------------------------- cloud AI --

# ollama.com API key — https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Chat model. The ollama.com cloud catalog decides what is valid here;
# `curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/api/tags`
# lists them. qwen3:8b only exists on a local ollama, not in the cloud.
OLLAMA_MODEL=gpt-oss:20b

# Embedding model, for the semantic half of hybrid search. ollama.com does not
# serve embeddings at all — /api/embed answers `unauthorized` for every key —
# so on the cloud this is ignored and the local hashing embedder takes over.
# Point OLLAMA_HOST at a daemon to get real vectors.
OLLAMA_EMBED=embeddinggemma

# Reasoning effort: low | medium | high | off. gpt-oss ignores `think=false`
# and reasons anyway, so "low" keeps the hidden preamble short and stops it
# from eating the whole token budget and returning an empty message.
OLLAMA_THINK=low

# Seconds of a quiet console before JARVIS takes the helm and runs the swarm
# himself. Any key, click or mouse move hands it straight back.
JARVIS_IDLE_SECONDS=60

# The cloud host. A local daemon belongs under ONDEVICE_HOST above, not here:
# this is the brain that is *not* this machine.
OLLAMA_HOST=https://ollama.com

# Where everything is kept. Defaults to ~/.causewaybayjarvis.
# JARVIS_HOME=

# Which brain answers is NOT set here: it is a setting in the space, flipped
# with F9 in the client or `agentd provider.set auto|ondevice|cloud`, so the
# GUI and the CLI always agree. JARVIS_NO_MLX=1 keeps a `make gui` build off
# the on-device engine without rebuilding.
#
# Every value above can also be changed on the client's SETTINGS > AI tab or
# with `agentd config.set <key> <value>`; those are kept in the space and
# beat this file. A variable set in the process environment beats both, for
# that run. `agentd config` shows each value and where it came from.
