# Build output
target/
/dist

# Runtime state: the sqlite db, saved transcripts, anything the agent writes.
# Model weights live in the shared Hugging Face cache, not here.
/data

# Editor and OS noise
*.rs.bk
.DS_Store

# The plates the LÖVE client draws on. `make art` paints them with Grok; the
# client draws Hradcany out of rectangles when they are absent.
/love/assets/bg/*.jpg
/love/assets/bg/*.png
