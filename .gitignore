# Build output
target/
/dist

# Runtime state: the sqlite db, saved transcripts, anything the agent writes.
# Model weights live in the shared Hugging Face cache, not here.
/data

# Editor and OS noise
*.rs.bk
.DS_Store

# The plates the LÖVE client draws on. `make art` paints them with Grok; the
# client draws Hradcany out of rectangles when they are absent.
/love/assets/bg/*.jpg
/love/assets/bg/*.png

# The robot client's ollama key. `robots/.env.example` is the template.
/robots/.env
/robots/QA
/robots/.jarvis.pid

dist/

# Any .env anywhere: keys never belong in the tree.
.env

# Discarded look prototypes. Never commit.
look_wonderboy_*.png
look_valis_*.png
**/look_wonderboy_*.png
**/look_valis_*.png
robots/assets/themes/wonderboy/
robots/assets/themes/valis/
robots/persistency/wonderboy.jsonl
robots/persistency/valis.jsonl

